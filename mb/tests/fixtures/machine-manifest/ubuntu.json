{
  "manifest_version": 1,
  "labels": {
    "run_dir": "/run/box-users",
    "shared_group": "box-users",
    "tool_root": "/opt/box-tools",
    "nft_table": "inet box_users"
  },
  "host": {
    "hostname": "box-01",
    "role": "agent-host",
    "os": {
      "family": "ubuntu",
      "distribution": "ubuntu",
      "release_model": "lts",
      "version_id": "26.04",
      "install_media_verified": true
    },
    "power": {
      "after_power_loss": "power-on",
      "wake_on_lan": true,
      "sleep": "never"
    },
    "disk": {
      "encryption": "luks2-tpm2",
      "tpm2_pcrs": [
        7
      ],
      "header_backup_offhost": true,
      "min_free_percent": 15,
      "unattended_boot": true
    },
    "desktop": {
      "session": "none",
      "auto_login": false,
      "screen_lock_minutes": 5,
      "agents_in_desktop_session": false
    }
  },
  "owner": {
    "user": "admin",
    "admin_key_fingerprint": "SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "sudo": "password-required",
    "sudo_into_business": false
  },
  "businesses": {
    "uid_range": {
      "min": 2001,
      "max": 2099
    },
    "home_mode": "0700",
    "tmpdir_mode": "0700",
    "sizing_basis": {
      "host_ram_gb": 32,
      "reserved_host_gb": 6
    },
    "size_classes": {
      "light": {
        "memory_high": "4G",
        "capped_run_max": "2G",
        "tasks_max": 4096
      },
      "heavy": {
        "memory_high": "8G",
        "capped_run_max": "5G",
        "tasks_max": 4096
      }
    },
    "users": [
      {
        "business": "biza",
        "user": "biz-a-agent",
        "uid": 2001,
        "groups": [
          "box-users"
        ],
        "size_class": "light",
        "sudo": false
      },
      {
        "business": "bizb",
        "user": "biz-b-agent",
        "uid": 2002,
        "groups": [
          "box-users"
        ],
        "size_class": "heavy",
        "sudo": false,
        "browsers": [
          {
            "profile": "bizb",
            "port": 9300,
            "start": true
          }
        ]
      }
    ]
  },
  "shared_tools": {
    "owner": "root:root",
    "writable_by_others": false,
    "version_manager": "mise",
    "tools": [
      {
        "name": "node",
        "version": "26.12.1",
        "source": "mise",
        "bins": [
          "node",
          "npm",
          "npx"
        ]
      },
      {
        "name": "uv",
        "version": "0.13.5",
        "source": "mise"
      },
      {
        "name": "gh",
        "version": "2.103.1",
        "source": "mise"
      },
      {
        "name": "herdr",
        "version": "0.9.5",
        "source": "mise"
      },
      {
        "name": "claude",
        "version": "2.1.309",
        "source": "mise"
      },
      {
        "name": "codex",
        "version": "0.164.0",
        "source": "mise"
      },
      {
        "name": "mb",
        "version": "0.6.16",
        "source": "mise"
      },
      {
        "name": "pnpm",
        "version": "10.34.7",
        "source": "npm-tarball",
        "sha256": "c729f6538e005d234889910466fd1c4c44affb0b28ea86d93fcf88aa1aefa694"
      },
      {
        "name": "ffmpeg",
        "version": "8.1.3-9-g29e619e767",
        "source": "upstream-tarball",
        "sha256": "97ce978979194b5cf7e06a5e68020dbdaa7a4f3294c5452b6a1bc347100dbb79",
        "bins": [
          "ffmpeg",
          "ffprobe"
        ]
      }
    ]
  },
  "runtime": {
    "herdr": {
      "tool": "herdr",
      "pinned_by": "shared_tools",
      "auto_update": false,
      "per_user_auth": "none",
      "per_user_server": true
    },
    "claude_code": {
      "tool": "claude",
      "pinned_by": "shared_tools",
      "auto_update": false,
      "per_user_auth": "device-code"
    },
    "codex": {
      "tool": "codex",
      "pinned_by": "shared_tools",
      "auto_update": false,
      "per_user_auth": "device-code"
    },
    "mb": {
      "tool": "mb",
      "pinned_by": "shared_tools",
      "auto_update": false,
      "per_user_auth": "stdin-secret"
    }
  },
  "remote_access": {
    "ssh": {
      "password_authentication": false,
      "kbd_interactive_authentication": false,
      "pubkey_authentication": true,
      "host_key_pinned_from_console": true,
      "allowed_sources": [
        "192.0.2.10/32",
        "198.51.100.20/32",
        "2001:db8::10/128"
      ],
      "agent_keys_restricted": true
    },
    "tailscale": {
      "min_version": "1.104.4",
      "run_ssh": false,
      "serve_ports": [],
      "funnel": false,
      "tagged_node": true
    },
    "admin_client": {
      "os": "linux",
      "ssh_key_store": "password-manager-agent",
      "herdr": "over-ssh",
      "screen": "none"
    },
    "vnc": {
      "mode": "none"
    }
  },
  "heavy_work": {
    "lock_name": "heavy.lock",
    "lock_mode": "0660",
    "env_var": "HEAVY_LOCK",
    "wrapper": "capped-run",
    "max_wait_seconds": 3600,
    "default_timeout_seconds": 900
  },
  "backups": {
    "target": {
      "kind": "pull-from-backup-host",
      "host": "backup-01",
      "offsite": true
    },
    "schedule": "hourly",
    "max_age_hours": 30,
    "paths": [
      "/home/{user}"
    ],
    "restore_test": {
      "required_before_business_data": true,
      "max_age_days": 90,
      "record": "/var/lib/machine-doctor/restore-test.json"
    }
  },
  "hardening": {
    "firewall": {
      "tool": "ufw",
      "default_incoming": "deny"
    },
    "updates": {
      "model": "unattended-security",
      "origins": [
        "security"
      ],
      "auto_reboot": false
    },
    "firmware_auto_apply": false,
    "ipc_isolation": "separate-platform-review",
    "agent_shell": {
      "landlock": true,
      "abstract_unix_scope": true
    },
    "egress_fence": {
      "socket_mark": true,
      "deny": [
        "lan",
        "tailnet",
        "link-local",
        "multicast",
        "other-business-loopback"
      ]
    },
    "proc_hidepid": "invisible",
    "unit_text_public": true,
    "kill_guard": true,
    "apparmor_userns_profile": true
  },
  "checks": {}
}
